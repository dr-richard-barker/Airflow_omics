\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Study design.} Flight (solid) and ground-control (light) samples in each of the 11 OSDR studies, coloured by hardware class and labelled by platform. APEX-TAGES (OSD-7) flight samples are grouped with BRIC; EMCS (OSD-314) has no CFD scenario. Source: \texttt  {expression\_metadata\_with\_cfd\_v2.tsv}.}}{7}{figure.caption.23}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:design}{{1}{7}{\textbf {Study design.} Flight (solid) and ground-control (light) samples in each of the 11 OSDR studies, coloured by hardware class and labelled by platform. APEX-TAGES (OSD-7) flight samples are grouped with BRIC; EMCS (OSD-314) has no CFD scenario. Source: \texttt {expression\_metadata\_with\_cfd\_v2.tsv}}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {The flight response is largely study-specific.} Mean percent of each gene's variance explained by each component, for the pooled data (genes measured in all studies) and the RNA-seq studies alone. Every factor is a random effect; study is nested in hardware. Source: REANALYSIS §12.}}{7}{figure.caption.24}\protected@file@percent }
\newlabel{fig:vp}{{2}{7}{\textbf {The flight response is largely study-specific.} Mean percent of each gene's variance explained by each component, for the pooled data (genes measured in all studies) and the RNA-seq studies alone. Every factor is a random effect; study is nested in hardware. Source: REANALYSIS §12}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Agreement of flight effects between studies.} Pearson correlation of flight $\log _2$ fold changes between study $\times $ organ units, grouped by hardware and platform. BRIC RNA-seq units agree (median $r = 0.40$ between studies); BRIC microarray units agree neither with each other nor with RNA-seq. Source: REANALYSIS §13.}}{8}{figure.caption.25}\protected@file@percent }
\newlabel{fig:platform}{{3}{8}{\textbf {Agreement of flight effects between studies.} Pearson correlation of flight $\log _2$ fold changes between study $\times $ organ units, grouped by hardware and platform. BRIC RNA-seq units agree (median $r = 0.40$ between studies); BRIC microarray units agree neither with each other nor with RNA-seq. Source: REANALYSIS §13}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {No pathway-level flight effect.} Flight effect (flight minus ground) per pathway with 95\% confidence intervals, from a within-study model with cluster-robust errors by study (11 studies), on scores computed within each study without zero-filling. Intervals are not adjusted for multiple testing; no pathway reaches FDR $< 0.05$. Source: REANALYSIS §10.}}{9}{figure.caption.26}\protected@file@percent }
\newlabel{fig:pathways}{{4}{9}{\textbf {No pathway-level flight effect.} Flight effect (flight minus ground) per pathway with 95\% confidence intervals, from a within-study model with cluster-robust errors by study (11 studies), on scores computed within each study without zero-filling. Intervals are not adjusted for multiple testing; no pathway reaches FDR $< 0.05$. Source: REANALYSIS §10}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Gravity penalty on leaf gas exchange, open air versus flight dish.} Leaf boundary-layer conductance at 1\,g (filled) and 0\,g (open) in an open box and inside the BRIC and CARA dishes, with the 1\,g/0\,g ratio. The sealed-BRIC 1\,g value is indicative only. Source: LunarLeaf-CFD T13 and T19.}}{9}{figure.caption.27}\protected@file@percent }
\newlabel{fig:cfd}{{5}{9}{\textbf {Gravity penalty on leaf gas exchange, open air versus flight dish.} Leaf boundary-layer conductance at 1\,g (filled) and 0\,g (open) in an open box and inside the BRIC and CARA dishes, with the 1\,g/0\,g ratio. The sealed-BRIC 1\,g value is indicative only. Source: LunarLeaf-CFD T13 and T19}{figure.caption.27}{}}
