\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Study overview and variance partition.} (A) Sample counts by hardware type and flight condition. (B) Distribution of omics data types in the harmonized dataset. (C) Variance partition across factors, showing study (65.3\%) as the dominant source, followed by hardware (7.1\%), light (6.4\%), ecotype (5.2\%), organ (2.4\%), and flight (1.5\%).}}{8}{figure.caption.24}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{8}{\textbf {Study overview and variance partition.} (A) Sample counts by hardware type and flight condition. (B) Distribution of omics data types in the harmonized dataset. (C) Variance partition across factors, showing study (65.3\%) as the dominant source, followed by hardware (7.1\%), light (6.4\%), ecotype (5.2\%), organ (2.4\%), and flight (1.5\%)}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Differential expression volcano plots.} (A) Flight main effect (FLT vs GC): 476 up, 264 down. (B) Hardware CARA vs BRIC: 2,388 up, 7,675 down. (C) Hardware Veggie vs BRIC: 633 up, 5,532 down. (D) CFD boundary layer conductance: 1,454 up, 2,179 down. FDR $< 0.05$, $|\log _2\text  {FC}| > 1$.}}{9}{figure.caption.25}\protected@file@percent }
\newlabel{fig:volcano}{{2}{9}{\textbf {Differential expression volcano plots.} (A) Flight main effect (FLT vs GC): 476 up, 264 down. (B) Hardware CARA vs BRIC: 2,388 up, 7,675 down. (C) Hardware Veggie vs BRIC: 633 up, 5,532 down. (D) CFD boundary layer conductance: 1,454 up, 2,179 down. FDR $< 0.05$, $|\log _2\text {FC}| > 1$}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {CFD covariate correlations with hormone and carbon pathway activity.} Pearson correlations between three CFD-derived gas-exchange parameters (boundary layer conductance $g_{bl}$, carbon fixation capacity, boundary layer thickness $\delta $) and 28 pathway scores. Negative correlations with $g_{bl}$ indicate that reduced gas exchange suppresses photosynthesis, hormone biosynthesis, and signaling pathways. All shown correlations are FDR $< 0.05$.}}{10}{figure.caption.26}\protected@file@percent }
\newlabel{fig:cfd_pathway}{{3}{10}{\textbf {CFD covariate correlations with hormone and carbon pathway activity.} Pearson correlations between three CFD-derived gas-exchange parameters (boundary layer conductance $g_{bl}$, carbon fixation capacity, boundary layer thickness $\delta $) and 28 pathway scores. Negative correlations with $g_{bl}$ indicate that reduced gas exchange suppresses photosynthesis, hormone biosynthesis, and signaling pathways. All shown correlations are FDR $< 0.05$}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Hormone and carbon pathway activity by hardware and flight condition.} GSVA-like pathway scores for 15 key pathways across three hardware types (BRIC, CARA, Veggie) and two flight conditions (GC, FLT). Veggie shows consistently higher pathway activity than BRIC across nearly all hormones and carbon metabolism pathways.}}{11}{figure.caption.27}\protected@file@percent }
\newlabel{fig:allocation}{{4}{11}{\textbf {Hormone and carbon pathway activity by hardware and flight condition.} GSVA-like pathway scores for 15 key pathways across three hardware types (BRIC, CARA, Veggie) and two flight conditions (GC, FLT). Veggie shows consistently higher pathway activity than BRIC across nearly all hormones and carbon metabolism pathways}{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Inferred miRNA activity across spaceflight contrasts.} Heatmap showing inferred miRNA activity direction (blue = upregulated, targets suppressed; orange = downregulated, targets de-repressed) for 25 miRNAs across 6 key contrasts. miR164, miR167, and miR159 show consistent upregulation in CARA vs BRIC, implicating auxin and ABA pathway regulation.}}{11}{figure.caption.28}\protected@file@percent }
\newlabel{fig:mirna}{{5}{11}{\textbf {Inferred miRNA activity across spaceflight contrasts.} Heatmap showing inferred miRNA activity direction (blue = upregulated, targets suppressed; orange = downregulated, targets de-repressed) for 25 miRNAs across 6 key contrasts. miR164, miR167, and miR159 show consistent upregulation in CARA vs BRIC, implicating auxin and ABA pathway regulation}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {CFD-predicted gas-exchange parameters by hardware and gravity.} (A) Carbon fixation capacity (\% Earth rates at 12h). (B) Boundary layer conductance ($g_{bl}$, mol m\textsuperscript  {-2} s\textsuperscript  {-1}). (C) Boundary layer thickness ($\delta $, mm). BRIC hardware shows dramatic gas-exchange limitation in microgravity, while Veggie maintains near-terrestrial rates.}}{12}{figure.caption.29}\protected@file@percent }
\newlabel{fig:cfd_gas}{{6}{12}{\textbf {CFD-predicted gas-exchange parameters by hardware and gravity.} (A) Carbon fixation capacity (\% Earth rates at 12h). (B) Boundary layer conductance ($g_{bl}$, mol m\textsuperscript {-2} s\textsuperscript {-1}). (C) Boundary layer thickness ($\delta $, mm). BRIC hardware shows dramatic gas-exchange limitation in microgravity, while Veggie maintains near-terrestrial rates}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Pathway activity heatmap across all samples.} GSVA-like z-scores for 28 pathways across 307 samples, ordered by hardware, flight, and organ. Clear hardware-dependent clustering is visible, with Veggie samples showing higher pathway activity overall.}}{12}{figure.caption.30}\protected@file@percent }
\newlabel{fig:heatmap}{{7}{12}{\textbf {Pathway activity heatmap across all samples.} GSVA-like z-scores for 28 pathways across 307 samples, ordered by hardware, flight, and organ. Clear hardware-dependent clustering is visible, with Veggie samples showing higher pathway activity overall}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Differential expression summary across all contrasts.} Number of upregulated (orange) and downregulated (blue) genes for each contrast (FDR $< 0.05$, $|\log _2\text  {FC}| > 1$). Hardware comparisons (CARA vs BRIC, FLT BRIC vs CARA) show the largest effects, while the flight main effect is relatively modest.}}{13}{figure.caption.31}\protected@file@percent }
\newlabel{fig:de_summary}{{8}{13}{\textbf {Differential expression summary across all contrasts.} Number of upregulated (orange) and downregulated (blue) genes for each contrast (FDR $< 0.05$, $|\log _2\text {FC}| > 1$). Hardware comparisons (CARA vs BRIC, FLT BRIC vs CARA) show the largest effects, while the flight main effect is relatively modest}{figure.caption.31}{}}
